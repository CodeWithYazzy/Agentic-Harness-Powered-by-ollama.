# Environment variables (documented; no .env loader is bundled — export these)
# The bridge reads process.env directly. Defaults in parentheses.

# Port for the bridge + UI (47911)
PORT=47911

# Data dir for config.json / sessions.json / memory.json (~/.ollama-desktop)
OLLAMA_DESKTOP_DATA=

# Chrome executable for the Playwright e2e harness (tests/e2e only)
E2E_CHROME=
